# Get an access key at https://web3forms.com/ (the key is public by design).
# Vite inlines this value into the client bundle at build time.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional. Defaults to Web3Forms' free-plan hCaptcha sitekey. Only set this
# when the form uses custom hCaptcha keys.
VITE_HCAPTCHA_SITEKEY=
